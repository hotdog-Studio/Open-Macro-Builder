{
  "name": "open-macro-builder-configurator",
  "private": true,
  "description": "Visual editor for Open Macro Builder: the pad shape, the layers, the macros and the command files",
  "author": "hotdog Studio",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/hotdog-Studio/Open-Macro-Builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotdog-Studio/Open-Macro-Builder.git",
    "directory": "configurator"
  },
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:electron": "vitest run --config vitest.electron.config.ts",
    "lint": "eslint .",
    "dist": "npm run build && node scripts/build-electron.mjs && electron-builder --win nsis portable --x64 --publish never",
    "electron": "npm run build && node scripts/build-electron.mjs && node scripts/run-electron.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8"
  }
}
