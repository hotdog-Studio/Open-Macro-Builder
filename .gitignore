# Your own layout, commands, tests and notes: never committed (see local/README.md once created)
local/

# Agent tooling scratch
.superpowers/

# CI and local test / scan output
results/
coverage/
.scannerwork/

# SonarQube credentials for local scans (see sonar-project.properties)
.env.sonar

# Backups left by local config edits
*.bak

# Half-written files the configurator's desktop app leaves if it stops mid-save
*.omb-tmp

# Configurator build output and dependencies
node_modules/
configurator/dist/
configurator/dist-electron/
configurator/release/
configurator/*.tsbuildinfo

# Scratch output of the configurator browser tests (screenshot comparisons)
configurator/.vitest/
configurator/.vitest-attachments/
